# Код магазина — для автоматических заданий планировщика.
# Обычно выставляется не вручную, а через POST /api/stores/select.
STORE_CODE=

# Тип магазина: русское название (Магнит, Мини, М.Косметик, Семейный, Экстра, Моя цена),
# API-код (MM, MM_MINI, DG, GM, ME, MO, MC, ZARYAD) или числовой код (1, 2, 3, 5, 6, 7, 8, 9).
# Пусто — «Магнит».
STORE_TYPE=

# Разрешённые origins CORS через запятую. По умолчанию — любые (*).
CORS_ORIGINS=*
